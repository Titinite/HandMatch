# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner .env.
# Valeurs factices, réservées au développement local. Détail : docs/configuration.md

# --- Base de données (PostgreSQL) ---
# Compte créé au premier démarrage du conteneur db
POSTGRES_USER=handmatch
# Mot de passe de dev. En production : valeur forte et unique, jamais celle-ci
POSTGRES_PASSWORD=change-me
# Nom de la base
POSTGRES_DB=handmatch

# --- Backend ---
# Niveau de logs : fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=debug

# --- Ports publiés sur 127.0.0.1 uniquement ---
# Port de PostgreSQL
DB_PORT=5432
# Port de l'API
BACKEND_PORT=3000
# Port du serveur de développement Vite
FRONTEND_PORT=5173